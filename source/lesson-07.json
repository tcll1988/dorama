{
  "id": 7,
  "title": "你喜欢干什么？",
  "japanese": "好きなこと",
  "reading": [
    {
      "id": "drama-7-r-1",
      "speaker": "王",
      "ch": "你平时喜欢干什么？",
      "py": "nǐ píng shí xǐ huan gàn shén me ？",
      "jp": "ふだん何をするのが好きですか。",
      "audio": "audio/lesson07/reading-01.mp3"
    },
    {
      "id": "drama-7-r-2",
      "speaker": "山本",
      "ch": "我喜欢爬山。",
      "py": "wǒ xǐ huan pá shān 。",
      "jp": "私は山登りが好きです。",
      "audio": "audio/lesson07/reading-02.mp3"
    },
    {
      "id": "drama-7-r-3",
      "speaker": "王",
      "ch": "我也特别喜欢户外活动。",
      "py": "wǒ yě tè bié xǐ huan hù wài huó dòng 。",
      "jp": "私もアウトドア活動がとても好きです。",
      "audio": "audio/lesson07/reading-03.mp3"
    },
    {
      "id": "drama-7-r-4",
      "speaker": "王",
      "ch": "你喜欢听音乐吗？",
      "py": "nǐ xǐ huan tīng yīn yuè ma ？",
      "jp": "音楽を聞くのは好きですか。",
      "audio": "audio/lesson07/reading-04.mp3"
    },
    {
      "id": "drama-7-r-5",
      "speaker": "山本",
      "ch": "不喜欢。",
      "py": "bù xǐ huan 。",
      "jp": "好きではありません。",
      "audio": "audio/lesson07/reading-05.mp3"
    }
  ],
