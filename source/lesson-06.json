{
  "id": 6,
  "title": "我的一天",
  "japanese": "一日の生活",
  "reading": [
    {
      "id": "drama-6-r-1",
      "speaker": "王",
      "ch": "优子同学，早上好！你每天几点起床？",
      "py": "yōu zǐ tóng xué ， zǎo shang hǎo ！ nǐ měi tiān jǐ diǎn qǐ chuáng ？",
      "jp": "優子さん、おはようございます。毎日何時に起きますか。",
      "audio": "audio/lesson06/reading-01.mp3"
    },
    {
      "id": "drama-6-r-2",
      "speaker": "山本",
      "ch": "我每天早上七点半起床。",
      "py": "wǒ měi tiān zǎo shang qī diǎn bàn qǐ chuáng 。",
      "jp": "私は毎朝7時半に起きます。",
      "audio": "audio/lesson06/reading-02.mp3"
    },
    {
      "id": "drama-6-r-3",
      "speaker": "王",
      "ch": "你今天几点回家？",
      "py": "nǐ jīn tiān jǐ diǎn huí jiā ？",
      "jp": "今日は何時に家に帰りますか。",
      "audio": "audio/lesson06/reading-03.mp3"
    },
    {
      "id": "drama-6-r-4",
      "speaker": "山本",
      "ch": "我今天去打工，晚上八点半回家。",
      "py": "wǒ jīn tiān qù dǎ gōng ， wǎn shang bā diǎn bàn huí jiā 。",
      "jp": "今日はアルバイトに行って、夜8時半に家に帰ります。",
      "audio": "audio/lesson06/reading-04.mp3"
    }
  ],
  "words": [
    {
      "id": "drama-6-w-1",
      "ch": "早上好",
