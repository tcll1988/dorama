{
  "id": 9,
  "title": "你好！要一个油焖茄子。",
  "japanese": "料理を注文する",
  "reading": [
    {
      "id": "drama-9-r-1",
      "speaker": "山本",
      "ch": "你好！点菜！",
      "py": "nǐ hǎo ！ diǎn cài ！",
      "jp": "すみません、注文をお願いします。",
      "audio": "audio/lesson09/reading-01.mp3"
    },
    {
      "id": "drama-9-r-2",
      "speaker": "店员",
      "ch": "你好！",
      "py": "nǐ hǎo ！",
      "jp": "こんにちは。",
      "audio": "audio/lesson09/reading-02.mp3"
    },
    {
      "id": "drama-9-r-3",
      "speaker": "山本",
      "ch": "要一个油焖茄子、一个红烧排骨和一个锅包肉。",
      "py": "yào yí gè yóu mèn qié zi 、 yí gè hóng shāo pái gǔ hé yí gè guō bāo ròu 。",
      "jp": "ナスの油煮込みと豚スペアリブの醤油煮込みと揚げ豚肉の甘酢あんかけを一つずつください。",
      "audio": "audio/lesson09/reading-03.mp3"
    },
    {
      "id": "drama-9-r-4",
      "speaker": "店员",
      "ch": "还要喝的吗？",
      "py": "hái yào hē de ma ？",
      "jp": "お飲み物もいかがですか。",
      "audio": "audio/lesson09/reading-04.mp3"
    },
    {
      "id": "drama-9-r-5",
      "speaker": "山本",
      "ch": "不要，谢谢！",
      "py": "bú yào ， xiè xie ！",
      "jp": "いりません。ありがとうございます。",
      "audio": "audio/lesson09/reading-05.mp3"
    }
  ],
