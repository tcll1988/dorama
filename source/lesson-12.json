{
  "id": 12,
  "title": "洗手间在哪儿？",
  "japanese": "場所と道案内",
  "reading": [
    {
      "id": "drama-12-r-1",
      "speaker": "山本",
      "ch": "请问，洗手间在哪儿？",
      "py": "qǐng wèn ， xǐ shǒu jiān zài nǎ r ？",
      "jp": "すみません、トイレはどこですか。",
      "audio": "audio/lesson12/reading-01.mp3"
    },
    {
      "id": "drama-12-r-2",
      "speaker": "店员",
      "ch": "洗手间在那儿。",
      "py": "xǐ shǒu jiān zài nà r 。",
      "jp": "トイレはあそこです。",
      "audio": "audio/lesson12/reading-02.mp3"
    },
    {
      "id": "drama-12-r-3",
      "speaker": "山本",
      "ch": "请问，去文明小区二号楼怎么走？",
      "py": "qǐng wèn ， qù wén míng xiǎo qū èr hào lóu zěn me zǒu ？",
      "jp": "すみません、文明団地の2号棟へはどう行けばいいですか。",
      "audio": "audio/lesson12/reading-03.mp3"
    },
    {
      "id": "drama-12-r-4",
      "speaker": "店员",
      "ch": "往前走就是。",
      "py": "wǎng qián zǒu jiù shì 。",
      "jp": "前へ進めばそこです。",
      "audio": "audio/lesson12/reading-04.mp3"
    }
  ],
  "words": [
    {
