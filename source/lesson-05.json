{
  "id": 5,
  "title": "爸爸和妈妈",
  "japanese": "家族と年齢",
  "reading": [
    {
      "id": "drama-5-r-1",
      "speaker": "王",
      "ch": "你家有几口人？",
      "py": "nǐ jiā yǒu jǐ kǒu rén ？",
      "jp": "あなたの家族は何人ですか。",
      "audio": "audio/lesson05/reading-01.mp3"
    },
    {
      "id": "drama-5-r-2",
      "speaker": "山本",
      "ch": "我家有四口人。爸爸、妈妈，妹妹和我。",
      "py": "wǒ jiā yǒu sì kǒu rén 。 bà ba 、 mā ma ， mèi mei hé wǒ 。",
      "jp": "私の家族は4人です。父、母、妹と私です。",
      "audio": "audio/lesson05/reading-02.mp3"
    },
    {
      "id": "drama-5-r-3",
      "speaker": "王",
      "ch": "你妹妹几岁了？",
      "py": "nǐ mèi mei jǐ suì le ？",
      "jp": "妹さんは何歳ですか。",
      "audio": "audio/lesson05/reading-03.mp3"
    },
    {
      "id": "drama-5-r-4",
      "speaker": "山本",
      "ch": "我妹妹今年八岁。",
      "py": "wǒ mèi mei jīn nián bā suì 。",
      "jp": "妹は今年8歳です。",
      "audio": "audio/lesson05/reading-04.mp3"
    }
  ],
