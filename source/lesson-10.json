{
  "id": 10,
  "title": "请问，这个多少钱？",
  "japanese": "買い物",
  "reading": [
    {
      "id": "drama-10-r-1",
      "speaker": "山本",
      "ch": "你好！请问，这个多少钱？",
      "py": "nǐ hǎo ！ qǐng wèn ， zhè ge duō shao qián ？",
      "jp": "すみません、これはいくらですか。",
      "audio": "audio/lesson10/reading-01.mp3"
    },
    {
      "id": "drama-10-r-2",
      "speaker": "店員",
      "ch": "你好！一百块。你要几个？",
      "py": "nǐ hǎo ！ yì bǎi kuài 。 nǐ yào jǐ gè ？",
      "jp": "こんにちは。100元です。いくついりますか。",
      "audio": "audio/lesson10/reading-02.mp3"
    },
    {
      "id": "drama-10-r-3",
      "speaker": "山本",
      "ch": "我要两个。",
      "py": "wǒ yào liǎng ge 。",
      "jp": "二つください。",
      "audio": "audio/lesson10/reading-03.mp3"
    },
    {
      "id": "drama-10-r-4",
      "speaker": "店員",
      "ch": "好的，谢谢！",
      "py": "hǎo de ， xiè xie ！",
      "jp": "はい、ありがとうございます。",
      "audio": "audio/lesson10/reading-04.mp3"
    }
  ],
