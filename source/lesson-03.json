{
  "id": 3,
  "title": "今天星期天。",
  "japanese": "日付と曜日",
  "reading": [
    {
      "id": "drama-3-r-1",
      "speaker": "山本",
      "ch": "王老师，您好！今天几月几号？",
      "py": "wáng lǎo shī ， nín hǎo ！ jīn tiān jǐ yuè jǐ hào ？",
      "jp": "王先生、こんにちは。今日は何月何日ですか。",
      "audio": "audio/lesson03/reading-01.mp3"
    },
    {
      "id": "drama-3-r-2",
      "speaker": "王",
      "ch": "优子同学，你好！今天是一月二十五号。",
      "py": "yōu zǐ tóng xué ， nǐ hǎo ！ jīn tiān shì yī yuè èr shí wǔ hào 。",
      "jp": "優子さん、こんにちは。今日は1月25日です。",
      "audio": "audio/lesson03/reading-02.mp3"
    },
    {
      "id": "drama-3-r-3",
      "speaker": "山本",
      "ch": "今天星期几？",
      "py": "jīn tiān xīng qī jǐ ？",
      "jp": "今日は何曜日ですか。",
      "audio": "audio/lesson03/reading-03.mp3"
    },
    {
      "id": "drama-3-r-4",
      "speaker": "王",
      "ch": "今天星期天。",
      "py": "jīn tiān xīng qī tiān 。",
      "jp": "今日は日曜日です。",
      "audio": "audio/lesson03/reading-04.mp3"
    },
    {
      "id": "drama-3-r-5",
      "speaker": "山本",
      "ch": "谢谢！",
      "py": "xiè xie ！",
      "jp": "ありがとうございます。",
      "audio": "audio/lesson03/reading-05.mp3"
    },
    {
      "id": "drama-3-r-6",
      "speaker": "王",
      "ch": "不客气！",
      "py": "bú kè qi ！",
      "jp": "どういたしまして。",
      "audio": "audio/lesson03/reading-06.mp3"
    }
  ],
