{
  "id": 2,
  "title": "我是山本优子。",
  "japanese": "自己紹介",
  "reading": [
    {
      "id": "drama-2-r-1",
      "speaker": "山本",
      "ch": "王明老师，您好！我是山本优子。",
      "py": "wáng míng lǎo shī ， nín hǎo ！ wǒ shì shān běn yōu zǐ 。",
      "jp": "王明先生、こんにちは。私は山本優子です。",
      "audio": "audio/lesson02/reading-01.mp3"
    },
    {
      "id": "drama-2-r-2",
      "speaker": "王",
      "ch": "优子同学，你好！",
      "py": "yōu zǐ tóng xué ， nǐ hǎo ！",
      "jp": "優子さん、こんにちは。",
      "audio": "audio/lesson02/reading-02.mp3"
    },
    {
      "id": "drama-2-r-3",
      "speaker": "山本",
      "ch": "王老师，拜拜！",
      "py": "wáng lǎo shī ， bái bái ！",
      "jp": "王先生、またね。",
      "audio": "audio/lesson02/reading-03.mp3"
    },
    {
      "id": "drama-2-r-4",
      "speaker": "王",
      "ch": "优子同学，再见！",
      "py": "yōu zǐ tóng xué ， zài jiàn ！",
      "jp": "優子さん、さようなら。",
      "audio": "audio/lesson02/reading-04.mp3"
    }
  ],
  "words": [
    {
      "id": "drama-2-w-1",
