{
  "id": 14,
  "title": "过年好！",
  "japanese": "新年と誕生日",
  "reading": [
    {
      "id": "drama-14-r-1",
      "speaker": "山本",
      "ch": "今天是中国的春节。过年好！",
      "py": "jīn tiān shì zhōng guó de chūn jié 。 guò nián hǎo ！",
      "jp": "今日は中国の春節です。あけましておめでとうございます。",
      "audio": "audio/lesson14/reading-01.mp3"
    },
    {
      "id": "drama-14-r-2",
      "speaker": "王",
      "ch": "新年快乐！祝你身体健康，万事如意！",
      "py": "xīn nián kuài lè ！ zhù nǐ shēn tǐ jiàn kāng ， wàn shì rú yì ！",
      "jp": "新年おめでとうございます。健康で、すべてがうまくいきますように。",
      "audio": "audio/lesson14/reading-02.mp3"
    },
    {
      "id": "drama-14-r-3",
      "speaker": "山本",
      "ch": "今天也是我的生日。",
      "py": "jīn tiān yě shì wǒ de shēng rì 。",
      "jp": "今日は私の誕生日でもあります。",
      "audio": "audio/lesson14/reading-03.mp3"
    },
    {
      "id": "drama-14-r-4",
      "speaker": "王",
      "ch": "祝你生日快乐！学习进步！",
      "py": "zhù nǐ shēng rì kuài lè ！ xué xí jìn bù ！",
      "jp": "お誕生日おめでとうございます。勉強が上達しますように。",
      "audio": "audio/lesson14/reading-04.mp3"
    },
    {
      "id": "drama-14-r-5",
      "speaker": "王",
      "ch": "天天开心！",
      "py": "tiān tiān kāi xīn ！",
      "jp": "毎日楽しく過ごせますように。",
      "audio": "audio/lesson14/reading-05.mp3"
    }
  ],
