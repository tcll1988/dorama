{
  "id": 11,
  "title": "到北京机场。",
  "japanese": "タクシーに乗る",
  "reading": [
    {
      "id": "drama-11-r-1",
      "speaker": "山本",
      "ch": "您好！司机师傅，到北京机场。",
      "py": "nín hǎo ！ sī jī shī fu ， dào běi jīng jī chǎng 。",
      "jp": "こんにちは。運転手さん、北京空港までお願いします。",
      "audio": "audio/lesson11/reading-01.mp3"
    },
    {
      "id": "drama-11-r-2",
      "speaker": "司机",
      "ch": "好的。您是日本人吧？",
      "py": "hǎo de 。 nín shì rì běn rén ba ？",
      "jp": "わかりました。日本の方でしょう。",
      "audio": "audio/lesson11/reading-02.mp3"
    },
    {
      "id": "drama-11-r-3",
      "speaker": "山本",
      "ch": "是的。",
      "py": "shì de 。",
      "jp": "そうです。",
      "audio": "audio/lesson11/reading-03.mp3"
    },
    {
      "id": "drama-11-r-4",
      "speaker": "司机",
      "ch": "您的中文很好。",
      "py": "nín de zhōng wén hěn hǎo 。",
      "jp": "中国語がお上手ですね。",
      "audio": "audio/lesson11/reading-04.mp3"
    },
    {
      "id": "drama-11-r-5",
      "speaker": "山本",
      "ch": "哪里哪里。",
      "py": "nǎ lǐ nǎ lǐ 。",
      "jp": "いえいえ、とんでもないです。",
      "audio": "audio/lesson11/reading-05.mp3"
    },
    {
      "id": "drama-11-r-6",
      "speaker": "司机",
      "ch": "到了，一共五十六块。",
      "py": "dào le ， yí gòng wǔ shí liù kuài 。",
      "jp": "着きました。全部で56元です。",
      "audio": "audio/lesson11/reading-06.mp3"
    },
    {
      "id": "drama-11-r-7",
      "speaker": "山本",
      "ch": "谢谢。",
      "py": "xiè xie 。",
      "jp": "ありがとうございます。",
      "audio": "audio/lesson11/reading-07.mp3"
    }
  ],
