  "title": "你想喝什么？",
  "japanese": "食べたいもの・飲みたいもの",
  "reading": [
    {
      "id": "drama-8-r-1",
      "speaker": "王",
      "ch": "你想喝什么？",
      "py": "nǐ xiǎng hē shén me ？",
      "jp": "何を飲みたいですか。",
