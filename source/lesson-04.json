{
  "id": 4,
  "title": "现在9点20分",
  "japanese": "時間と授業",
  "reading": [
    {
      "id": "drama-4-r-1",
      "speaker": "山本",
      "ch": "王老师，现在几点？",
      "py": "wáng lǎo shī ， xiàn zài jǐ diǎn ？",
      "jp": "王先生、今何時ですか。",
      "audio": "audio/lesson04/reading-01.mp3"
    },
    {
      "id": "drama-4-r-2",
      "speaker": "王",
      "ch": "优子同学，现在九点二十分，要上课了。",
      "py": "yōu zǐ tóng xué ， xiàn zài jiǔ diǎn èr shí fēn ， yào shàng kè le 。",
      "jp": "優子さん、今9時20分です。もうすぐ授業が始まります。",
      "audio": "audio/lesson04/reading-02.mp3"
    },
    {
      "id": "drama-4-r-3",
      "speaker": "山本",
      "ch": "王老师，您几点下课？",
      "py": "wáng lǎo shī ， nín jǐ diǎn xià kè ？",
      "jp": "王先生、何時に授業が終わりますか。",
      "audio": "audio/lesson04/reading-03.mp3"
    },
    {
      "id": "drama-4-r-4",
      "speaker": "王",
      "ch": "我今天下午三点半下课。",
      "py": "wǒ jīn tiān xià wǔ sān diǎn bàn xià kè 。",
      "jp": "私は今日午後3時半に授業が終わります。",
      "audio": "audio/lesson04/reading-04.mp3"
    }
  ],
